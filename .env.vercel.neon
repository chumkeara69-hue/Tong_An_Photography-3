# Vercel + Neon production environment
# DATABASE_URL: Neon pooled/runtime connection string
# DIRECT_URL: Neon direct/unpooled connection string for Prisma migrations
DATABASE_URL="PASTE_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="PASTE_NEON_DIRECT_CONNECTION_STRING"

APP_URL="https://YOUR-VERCEL-DOMAIN.vercel.app"
NODE_ENV="production"

ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
ADMIN_PASSWORD="USE_A_LONG_UNIQUE_PASSWORD"

STORAGE_PROVIDER="s3"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
S3_BUCKET="YOUR_PRIVATE_S3_BUCKET"
S3_PUBLIC_BASE_URL=""
S3_SSE="AES256"
